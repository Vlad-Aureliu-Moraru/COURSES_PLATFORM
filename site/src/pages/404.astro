---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina nu există — BaniOnline" description="Pagina pe care o cauți nu există.">
  <section class="mx-auto flex w-full max-w-lg flex-col items-center px-5 py-24 text-center sm:px-8">
    <p class="font-sans text-7xl font-extrabold tracking-tight text-brand-600">404</p>
    <h1 class="mt-4 font-sans text-2xl font-bold text-ink">Pagina nu a fost găsită</h1>
    <p class="mt-3 text-slate-600">Poate că link-ul s-a schimbat sau pagina a fost mutată.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-lg bg-brand-600 px-7 py-3 text-base font-semibold text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-700"
    >
      Înapoi acasă
    </a>
  </section>
</Layout>
