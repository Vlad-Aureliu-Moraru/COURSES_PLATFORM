---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Badge from '../../components/ui/Badge.astro';
import { isFree } from '../../lib/access';

const modules = await getCollection('courses');
const freeModules = modules
  .filter((m) => isFree(m))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="Ghid gratuit — BaniOnline" description="Ghid gratuit pentru începători: cum să faci primii bani online, cum eviți scam-urile.">
  <section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
    <div class="mb-12 max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-brand-600">Citește gratuit</p>
      <h1 class="font-sans text-4xl font-extrabold tracking-tight text-ink">Ghidul gratuit de pornire</h1>
      <p class="mt-4 text-lg text-slate-600">
        Aceste module le poți citi fără să plătești. Dacă îți sunt utile, cursul complet îți arată restul metodei.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        freeModules.map((m) => (
          <article class="group flex min-w-0 flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-soft transition-all hover:-translate-y-1 hover:border-brand-200 hover:shadow-lift">
            <div class="mb-4 flex items-center justify-between">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-sm font-bold text-brand-700 transition-colors group-hover:bg-brand-600 group-hover:text-white">
                {(m.data.order ?? 0) + 1}
              </span>
              <Badge tone="green">Gratuit</Badge>
            </div>
            <h2 class="font-sans text-lg font-semibold leading-snug text-ink">
              <a href={`/curs/${m.id}`} class="transition-colors group-hover:text-brand-700">{m.data.title}</a>
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{m.data.description}</p>
            <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
              <span class="text-xs text-slate-400">{m.data.est_time}</span>
              <a href={`/curs/${m.id}`} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-colors group-hover:text-brand-700">
                Citește <span class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-14 relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 p-10 text-center shadow-float">
      <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-white/10 blur-2xl"></div>
      <div class="relative">
        <h2 class="font-sans text-2xl font-bold text-white">Ți-a plăcut? Restul e în curs.</h2>
        <p class="mx-auto mt-2 max-w-lg text-white/80">
          Toate metodele complete de câștig, planul de 30 de zile și fișa de urmărire — cu o singură plată.
        </p>
        <button data-checkout class="mt-6 inline-flex cursor-pointer items-center justify-center rounded-lg bg-white px-7 py-3 text-base font-semibold text-brand-700 shadow-float transition-all hover:-translate-y-0.5 hover:bg-brand-50">
          Deblochează cursul — €7.99
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { startCheckout } from '../../lib/api';
  document.querySelectorAll<HTMLElement>('[data-checkout]').forEach((btn) => {
    btn.addEventListener('click', () => {
      startCheckout().catch(() => {
        btn.textContent = 'Nu am putut iniția plata. Încearcă din nou.';
      });
    });
  });
</script>
