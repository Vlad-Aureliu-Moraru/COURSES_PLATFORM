---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import CourseSidebar from '../../components/CourseSidebar.astro';
import Badge from '../../components/ui/Badge.astro';

export async function getStaticPaths() {
  const modules = await getCollection('courses');
  return modules.map((m) => ({ params: { slug: m.id }, props: { module: m } }));
}

const { module } = Astro.props;
const modules = await getCollection('courses');

const rendered = await render(module);

const index = [...modules].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const current = index.findIndex((m) => m.id === module.id);
const prev = current > 0 ? index[current - 1] : null;
const next = current < index.length - 1 ? index[current + 1] : null;

const isFreeModule = Boolean(module.data.free);
const shortTitle = module.data.title?.replace(/^Modulul\s+\d+\s+—\s+/, '') ?? module.id;
---

<Layout
  title={`${module.data.title ?? module.id} — BaniOnline`}
  description={module.data.description}
  noindex={!isFreeModule}
>
  <div class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-8">
    <nav class="mb-6 flex items-center gap-2 text-sm text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="transition-colors hover:text-brand-600">Acasă</a>
      <span>/</span>
      <a href="/curs" class="transition-colors hover:text-brand-600">Curs</a>
      <span>/</span>
      <span class="truncate text-slate-600">{shortTitle}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[260px_1fr]">
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto rounded-xl border border-slate-200 bg-white p-4">
          <p class="mb-1 px-3 text-sm font-semibold text-ink">Cuprins</p>
          <p class="mb-3 px-3 text-xs text-slate-400">{current + 1} din {index.length} module</p>
          <CourseSidebar modules={modules} currentSlug={module.id} />
        </div>
      </aside>

      <article class="min-w-0">
        {isFreeModule ? (
          <>
            <div class="mb-6 flex flex-wrap items-center gap-3">
              <Badge tone="green">Gratuit</Badge>
              {module.data.est_time && <Badge tone="slate">≈ {module.data.est_time}</Badge>}
            </div>
            <div class="prose-course">
              <rendered.Content />
            </div>
          </>
        ) : (
          <>
            <div class="mb-6 flex flex-wrap items-center gap-3">
              {module.data.est_time && <Badge tone="slate">≈ {module.data.est_time}</Badge>}
              <Badge tone="slate">Inclus în cursul complet</Badge>
            </div>
            <div class="prose-course hidden" data-lesson-content></div>
            <div class="mt-4 flex items-center justify-center gap-2 py-6 text-sm text-slate-400" data-lesson-loading>
              <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-brand-200 border-t-brand-600"></span>
              Se încarcă lecția…
            </div>
          </>
        )}

        <div class="mt-12 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2" data-gated-content>
          {prev ? (
            <a
              href={`/curs/${prev.id}`}
              class="group rounded-xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lift"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">← Modulul anterior</p>
              <p class="mt-1.5 font-sans font-semibold text-ink group-hover:text-brand-700">
                {prev.data.title?.replace(/^Modulul\s+\d+\s+—\s+/, '')}
              </p>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={`/curs/${next.id}`}
              class="group rounded-xl border border-slate-200 bg-white p-5 text-right transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lift"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Modulul următor →</p>
              <p class="mt-1.5 font-sans font-semibold text-ink group-hover:text-brand-700">
                {next.data.title?.replace(/^Modulul\s+\d+\s+—\s+/, '')}
              </p>
            </a>
          ) : (
            <span />
          )}
        </div>

        {!isFreeModule && (
          <div data-gated-paywall class="mt-8 rounded-2xl border border-slate-200 bg-white p-10 text-center">
            <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-3xl">🔒</div>
            <h1 class="font-sans text-2xl font-bold text-ink">Acest modul face parte din cursul complet</h1>
            <p class="mx-auto mt-3 max-w-md text-slate-600">
              Deblochezi toate cele 12 module, plus planul de 30 de zile și fișa de urmărire, cu o singură plată.
            </p>
            <ul class="mx-auto mt-6 max-w-sm space-y-2 text-left text-sm text-slate-600">
              <li class="flex items-start gap-2"><span class="mt-0.5 text-emerald-600">✓</span> Acces instant la toate modulele</li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-emerald-600">✓</span> Plan de 30 de zile + fișă de urmărire</li>
            </ul>
            <div class="mt-8">
              <button
                data-checkout
                class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-brand-600 px-7 py-3 text-base font-semibold text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-700"
              >
                Deblochează cursul — €7.99
              </button>
            </div>
          </div>
        )}
      </article>
    </div>
  </div>
</Layout>

<script>
  import { getLesson, getLessonContent, startCheckout } from '../../lib/api';

  const slug = window.location.pathname.split('/').filter(Boolean).pop() ?? '';
  const contentEl = document.querySelector<HTMLElement>('[data-lesson-content]');
  const loadingEl = document.querySelector<HTMLElement>('[data-lesson-loading]');
  const navEl = document.querySelector<HTMLElement>('[data-gated-content]');
  const paywallEl = document.querySelector<HTMLElement>('[data-gated-paywall]');

  if (contentEl) {
    if (navEl) navEl.classList.add('hidden');
    if (paywallEl) paywallEl.classList.add('hidden');

    (async () => {
      const lesson = await getLesson(slug);
      if (lesson?.is_unlocked) {
        const html = await getLessonContent(slug);
        if (contentEl && html) {
          contentEl.innerHTML = html;
          contentEl.classList.remove('hidden');
        }
        navEl?.classList.remove('hidden');
        paywallEl?.classList.add('hidden');
      } else {
        paywallEl?.classList.remove('hidden');
        navEl?.classList.remove('hidden');
      }
      if (loadingEl) loadingEl.remove();
    })();
  }

  document.querySelectorAll<HTMLElement>('[data-checkout]').forEach((btn) => {
    btn.addEventListener('click', () => {
      startCheckout().catch(() => {
        btn.textContent = 'Nu am putut iniția plata. Încearcă din nou.';
      });
    });
  });
</script>
