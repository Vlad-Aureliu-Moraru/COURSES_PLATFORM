---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import CourseSidebar from '../../components/CourseSidebar.astro';
import Badge from '../../components/ui/Badge.astro';
import { hasAccess } from '../../lib/access';

export async function getStaticPaths() {
  const modules = await getCollection('courses');
  return modules.map((m) => ({ params: { slug: m.id }, props: { module: m } }));
}

const { module } = Astro.props;
const modules = await getCollection('courses');

const open = hasAccess(module);
const rendered = open ? await render(module) : null;

const index = [...modules].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const current = index.findIndex((m) => m.id === module.id);
const prev = current > 0 ? index[current - 1] : null;
const next = current < index.length - 1 ? index[current + 1] : null;

const shortTitle = module.data.title?.replace(/^Modulul\s+(Bonus\s+)?(\d+\s+—\s+)?/, '') ?? module.id;
---

<Layout title={`${module.data.title ?? module.id} — BaniOnline`} description={module.data.description}>
  <div class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-8">
    <nav class="mb-6 flex items-center gap-2 text-sm text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="transition-colors hover:text-brand-600">Acasă</a>
      <span>/</span>
      <a href="/curs" class="transition-colors hover:text-brand-600">Curs</a>
      <span>/</span>
      <span class="truncate text-slate-600">{shortTitle}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[260px_1fr]">
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto rounded-xl border border-slate-200 bg-white p-4">
          <p class="mb-1 px-3 text-sm font-semibold text-ink">Cuprins</p>
          <p class="mb-3 px-3 text-xs text-slate-400">{current + 1} din {index.length} module</p>
          <CourseSidebar modules={modules} currentSlug={module.id} />
        </div>
      </aside>

      <article class="min-w-0">
        {open && rendered ? (
          <>
            <div class="mb-6 flex flex-wrap items-center gap-3">
              {module.data.free && <Badge tone="green">Gratuit</Badge>}
              {module.data.est_time && <Badge tone="slate">≈ {module.data.est_time}</Badge>}
            </div>
            <div class="prose-course">
              <rendered.Content />
            </div>

            <div class="mt-12 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2">
              {prev && hasAccess(prev) ? (
                <a
                  href={`/curs/${prev.id}`}
                  class="group rounded-xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lift"
                >
                  <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">← Modulul anterior</p>
                  <p class="mt-1.5 font-sans font-semibold text-ink group-hover:text-brand-700">
                    {prev.data.title?.replace(/^Modulul\s+(Bonus\s+)?(\d+\s+—\s+)?/, '')}
                  </p>
                </a>
              ) : (
                <span />
              )}
              {next && hasAccess(next) ? (
                <a
                  href={`/curs/${next.id}`}
                  class="group rounded-xl border border-slate-200 bg-white p-5 text-right transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lift"
                >
                  <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Modulul următor →</p>
                  <p class="mt-1.5 font-sans font-semibold text-ink group-hover:text-brand-700">
                    {next.data.title?.replace(/^Modulul\s+(Bonus\s+)?(\d+\s+—\s+)?/, '')}
                  </p>
                </a>
              ) : (
                <span />
              )}
            </div>
          </>
        ) : (
          <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center">
            <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-3xl">🔒</div>
            <h1 class="font-sans text-2xl font-bold text-ink">Acest modul face parte din cursul complet</h1>
            <p class="mx-auto mt-3 max-w-md text-slate-600">
              Deblochezi toate cele 12 module, plus planul de 30 de zile și fișa de urmărire, cu o singură plată.
            </p>
            <ul class="mx-auto mt-6 max-w-sm space-y-2 text-left text-sm text-slate-600">
              <li class="flex items-start gap-2"><span class="mt-0.5 text-emerald-600">✓</span> Acces instant la toate modulele</li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-emerald-600">✓</span> Plan de 30 de zile + fișă de urmărire</li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-emerald-600">✓</span> Garanție de rambursare 14 zile</li>
            </ul>
            <div class="mt-8">
              <a href="/pricing" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-7 py-3 text-base font-semibold text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-700">
                Deblochează cursul — €7.99
              </a>
            </div>
          </div>
        )}
      </article>
    </div>
  </div>
</Layout>
