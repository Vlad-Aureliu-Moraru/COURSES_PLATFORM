---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Badge from '../../components/ui/Badge.astro';
import { isFree, hasAccess } from '../../lib/access';

const modules = await getCollection('courses');
const sorted = [...modules].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const freeCount = sorted.filter((m) => isFree(m)).length;
const unlockedCount = sorted.filter((m) => hasAccess(m)).length;
const allUnlocked = unlockedCount === sorted.length;
const progressPct = Math.round((unlockedCount / sorted.length) * 100);
---

<Layout title="Curs — BaniOnline" description="Cursul complet de bani online: toate modulele, pas cu pas.">
  <section class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8">
    <div class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-brand-600">Cursul complet</p>
      <h1 class="font-sans text-4xl font-extrabold tracking-tight text-ink">Banii Online, pas cu pas</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        {allUnlocked
          ? 'Toate modulele sunt deblocate. Parcurge-le în ordine — fiecare se construiește pe precedentul.'
          : `${unlockedCount} din ${sorted.length} module deblocate. Parcurge gratuit primele, apoi deblochează tot.`}
      </p>

      <div class="mt-6 max-w-sm">
        <div class="mb-1.5 flex items-center justify-between text-xs font-medium text-slate-500">
          <span>Progresul tău</span>
          <span>{progressPct}%</span>
        </div>
        <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
          <div class="h-full rounded-full bg-gradient-to-r from-brand-500 to-brand-600 transition-all" style={`width:${progressPct}%`}></div>
        </div>
      </div>
    </div>

    <div class="grid gap-4">
      {sorted.map((m, i) => {
        const open = hasAccess(m);
        return (
          <a
            href={open ? `/curs/${m.id}` : '/pricing'}
            class="group flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lift"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-sm font-bold text-brand-700">
              {i + 1}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-sans font-semibold text-ink">{m.data.title}</h3>
                {m.data.free ? <Badge tone="green">Gratuit</Badge> : null}
              </div>
              {m.data.description && <p class="mt-1 truncate text-sm text-slate-500">{m.data.description}</p>}
              <p class="mt-1.5 text-xs text-slate-400">
                {m.data.est_time ? `≈ ${m.data.est_time}` : ''}
                {open ? ' · deblocat' : ' · inclus în cursul complet'}
              </p>
            </div>
            <span class="shrink-0 rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-500 transition-colors group-hover:border-brand-200 group-hover:bg-brand-50 group-hover:text-brand-700">
              {open ? 'Deschide →' : 'Deblochează'}
            </span>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
