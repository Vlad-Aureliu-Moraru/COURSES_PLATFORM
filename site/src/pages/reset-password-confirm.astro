---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Setează o parolă nouă — BaniOnline" description="Setează o parolă nouă pentru contul tău.">
  <section class="mx-auto w-full max-w-md px-5 py-20 sm:px-8">
    <div class="mb-8 text-center">
      <h1 class="font-sans text-3xl font-extrabold tracking-tight text-ink">Setează o parolă nouă</h1>
      <p class="mt-2 text-sm text-slate-600">Alege o parolă nouă pentru contul tău.</p>
    </div>

    <form id="reset-confirm-form" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-8 shadow-soft">
      <div>
        <label for="password" class="mb-1.5 block text-sm font-medium text-slate-700">Parolă nouă</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="new-password"
          class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm text-ink outline-none transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
          placeholder="Cel puțin 8 caractere, literă și cifră"
        />
      </div>
      <div>
        <label for="password2" class="mb-1.5 block text-sm font-medium text-slate-700">Confirmă parola</label>
        <input
          id="password2"
          name="password2"
          type="password"
          required
          autocomplete="new-password"
          class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm text-ink outline-none transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
          placeholder="••••••••"
        />
      </div>

      <p id="form-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></p>

      <button
        type="submit"
        class="w-full rounded-lg bg-brand-600 px-6 py-3 text-base font-semibold text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-700"
      >
        Salvează parola
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-600">
      <a href="/login" class="font-semibold text-brand-600 hover:text-brand-700">Intră în cont</a>
    </p>
  </section>
</Layout>

<script>
  import { confirmPasswordReset } from '../lib/api';

  const token = new URLSearchParams(window.location.search).get('token') ?? '';
  const form = document.getElementById('reset-confirm-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('form-error') as HTMLParagraphElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;
    const password2 = (form.elements.namedItem('password2') as HTMLInputElement).value;
    if (password !== password2) {
      if (errorEl) {
        errorEl.textContent = 'Parolele nu coincid.';
        errorEl.classList.remove('hidden');
      }
      return;
    }
    if (errorEl) errorEl.classList.add('hidden');
    try {
      await confirmPasswordReset(token, password);
      window.location.href = '/login';
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : 'Resetarea a eșuat.';
        errorEl.classList.remove('hidden');
      }
    }
  });
</script>
