---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ModuleGrid from '../components/ModuleGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQ from '../components/FAQ.astro';

const courses = await getCollection('courses');

const stats = [
  { value: '12', label: 'module complete' },
  { value: '~6 ore', label: 'de conținut practic' },
  { value: '20+', label: 'platforme verificate' },
  { value: '30 zile', label: 'de plan pas cu pas' },
];

const faqs = [
  {
    q: 'Am nevoie de experiență?',
    a: 'Nu. Cursul este făcut pentru persoane fără experiență. Începi cu pași simpli și mergi înainte pe măsură ce înveți.',
  },
  {
    q: 'Cât de repede văd primii bani?',
    a: 'Realist, în primele 3–7 zile, cu 1–2 ore pe zi. Primele sume sunt mici ($1–5), dar reale. Nimeni nu poate garanta câștiguri — cine îți promite altceva te minte.',
  },
  {
    q: 'Cum retrag banii?',
    a: 'Prin PayPal sau Payoneer, de pe platformele verificate din curs. Îți arătăm pas cu pas, inclusiv cum îți faci conturile.',
  },
  {
    q: 'Este acesta un program de îmbogățire rapidă?',
    a: 'Exact invers. Cursul îți arată metode simple și sigure care aduc venituri mici, dar reale, și te învață să eviți scam-urile care promit milioane.',
  },
  {
    q: 'Cât durează să parcurg cursul?',
    a: 'Citești tot în ~6 ore, dar metoda este să aplici în paralel. Planul de 30 de zile îți arată exact ce să faci în fiecare zi.',
  },
];
---

<Layout
  title="BaniOnline — Curs practic de bani online pentru începători"
  description="Învață, pas cu pas, cum să faci primii bani online. Metode simple, verificate, de la $1–5 pe zi."
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-32 left-1/2 h-96 w-[56rem] -translate-x-1/2 rounded-full bg-brand-100/70 blur-3xl"></div>
      <div class="absolute right-0 top-40 h-72 w-72 rounded-full bg-brand-50 blur-3xl"></div>
      <div class="absolute -left-20 top-72 h-64 w-64 rounded-full bg-slate-100 blur-3xl"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgb(228_228_231/.35)_1px,transparent_1px),linear-gradient(to_bottom,rgb(228_228_231/.35)_1px,transparent_1px)] bg-[size:3rem_3rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,black,transparent)]"></div>
    </div>

    <div class="relative mx-auto w-full max-w-6xl px-5 pb-16 pt-20 text-center sm:px-8 sm:pt-28">
      <p class="mx-auto mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/80 px-4 py-1.5 text-xs font-semibold text-brand-700 shadow-soft backdrop-blur">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
        Metode verificate · Actualizat 2026
      </p>

      <h1 class="mx-auto max-w-3xl font-sans text-4xl font-extrabold tracking-tight text-ink sm:text-6xl">
        Fă-ți primii bani online,
        <span class="text-brand-600"> chiar din această săptămână.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
        Un curs practic pentru începători: micro-taskuri, sondaje plătite, platforme verificate și un plan de 30 de zile. Scop realist: <strong class="font-semibold text-ink">$1–5 pe zi</strong>, cu 1–2 ore.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button data-checkout class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-brand-600 px-7 py-3.5 text-base font-semibold text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-float">
          Începe cursul — €7.99
        </button>
        <a href="/blog" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-7 py-3.5 text-base font-semibold text-slate-700 shadow-soft transition-all hover:-translate-y-0.5 hover:border-slate-400">
          Începe gratuit
        </a>
      </div>

      <div class="mx-auto mt-7 flex max-w-xl flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-500">
        <span class="inline-flex items-center gap-1.5"><span class="text-emerald-600">✓</span> Acces instant</span>
        <span class="inline-flex items-center gap-1.5"><span class="text-emerald-600">✓</span> Fără abonament</span>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-5xl px-5 pb-20 sm:px-8">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-float">
        <div class="flex items-center gap-1.5 border-b border-slate-100 bg-slate-50/70 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-red-400"></span>
          <span class="h-3 w-3 rounded-full bg-amber-400"></span>
          <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
          <span class="ml-3 text-xs font-medium text-slate-400">curs.banionline.ro/start</span>
        </div>
        <div class="grid gap-px bg-slate-100 sm:grid-cols-3">
          {[0, 1, 2].map((i) => (
            <div class="bg-white p-5">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-brand-600">Modulul {i + 1}</p>
              <p class="mt-1.5 text-sm font-semibold text-ink">
                {['Ghid rapid — începe azi', 'Micro-taskuri — primul $1', 'Sondaje plătite — $0.5–3/zi'][i]}
              </p>
              <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
                <div class="h-full rounded-full bg-gradient-to-r from-brand-500 to-brand-600" style={`width: ${[100, 60, 35][i]}%`}></div>
              </div>
              <p class="mt-2 text-xs text-slate-400">{['Terminat', 'În curs', 'Următorul'][i]}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-surface-muted">
    <div class="mx-auto grid w-full max-w-6xl grid-cols-2 gap-8 px-5 py-10 sm:px-8 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="text-center">
          <p class="font-sans text-3xl font-extrabold tracking-tight text-ink">{s.value}</p>
          <p class="mt-1 text-sm text-slate-500">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8">
    <div class="mb-12 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-brand-600">Ce primești</p>
      <h2 class="font-sans text-3xl font-bold tracking-tight text-ink sm:text-4xl">Tot ce ai nevoie ca să începi</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600">12 module, de la zero până la prima retragere. Fără teorie inutilă.</p>
    </div>
    <ModuleGrid modules={courses} />
  </section>

  <section class="border-t border-slate-200 bg-white py-20">
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
      <div class="mb-12 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-brand-600">Simplu de urmat</p>
        <h2 class="font-sans text-3xl font-bold tracking-tight text-ink sm:text-4xl">Cum funcționează</h2>
      </div>
      <div class="grid gap-10 sm:grid-cols-3">
        <div class="relative text-center">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 font-sans text-lg font-bold text-white shadow-lift">
            1
          </div>
          <h3 class="font-sans text-lg font-semibold text-ink">Înscrie-te</h3>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-slate-600">Îți creezi contul, primești acces instant la toate cele 12 module.</p>
        </div>
        <div class="relative text-center">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 font-sans text-lg font-bold text-white shadow-lift">
            2
          </div>
          <h3 class="font-sans text-lg font-semibold text-ink">Începi azi</h3>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-slate-600">Ghidul de ziua 1 te duce de la zero la primul task în 2 ore.</p>
        </div>
        <div class="relative text-center">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 font-sans text-lg font-bold text-white shadow-lift">
            3
          </div>
          <h3 class="font-sans text-lg font-semibold text-ink">Retragi</h3>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-slate-600">Aduni, atingi pragul minim și retragi prin PayPal sau Payoneer.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8">
    <div class="mx-auto max-w-lg">
      <div class="mb-10 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-brand-600">Preț</p>
        <h2 class="font-sans text-3xl font-bold tracking-tight text-ink sm:text-4xl">O singură plată. Acces pe viață.</h2>
        <p class="mt-3 text-slate-600">Mai puțin decât o pizza. Cu potențialul de a-ți aduce primii $1–5 pe zi.</p>
      </div>
      <PricingCard price="€7.99" />
      <p class="mt-4 text-center text-xs text-slate-400">Plată securizată prin Stripe</p>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white py-20">
    <div class="mx-auto w-full max-w-3xl px-5 sm:px-8">
      <h2 class="mb-8 text-center font-sans text-3xl font-bold tracking-tight text-ink">Întrebări frecvente</h2>
      <FAQ items={faqs} />
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-8 py-16 text-center shadow-float">
      <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-10 h-56 w-56 rounded-full bg-white/10 blur-2xl"></div>
      <div class="relative">
        <h2 class="font-sans text-3xl font-bold tracking-tight text-white sm:text-4xl">Începe chiar azi</h2>
        <p class="mx-auto mt-4 max-w-xl text-white/80">
          Primul dolar pare mic. Devine $50, apoi $500 — depinde doar de cât de constant rămâi.
        </p>
        <button data-checkout class="mt-8 inline-flex cursor-pointer items-center justify-center rounded-lg bg-white px-8 py-3.5 text-base font-semibold text-brand-700 shadow-float transition-all hover:-translate-y-0.5 hover:bg-brand-50">
          Începe cursul — €7.99
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { startCheckout } from '../lib/api';
  document.querySelectorAll<HTMLElement>('[data-checkout]').forEach((btn) => {
    btn.addEventListener('click', () => {
      startCheckout().catch(() => {
        btn.textContent = 'Nu am putut iniția plata. Încearcă din nou.';
      });
    });
  });
</script>
