---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Plată confirmată — BaniOnline" description="Plata a fost procesată. Accesul tău la curs a fost activat.">
  <section class="mx-auto w-full max-w-lg px-5 py-24 sm:px-8">
    <div class="rounded-2xl border border-emerald-200 bg-white p-10 text-center shadow-soft">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-3xl">✓</div>
      <h1 class="font-sans text-3xl font-extrabold tracking-tight text-ink">Mulțumim! Plata a fost procesată</h1>
      <p class="mt-3 text-slate-600">
        Îți activăm accesul la toate cele 12 module. De obicei durează câteva secunde.
      </p>

      <p id="status" class="mt-4 text-sm text-slate-500">Se activează accesul…</p>

      <a
        href="/curs"
        id="go-curs"
        class="mt-8 inline-flex items-center justify-center rounded-lg bg-brand-600 px-7 py-3 text-base font-semibold text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
        aria-disabled="true"
      >
        Mergi la curs
      </a>
    </div>
  </section>
</Layout>

<script>
  import { getLesson, isAuthenticated } from '../lib/api';

  const statusEl = document.getElementById('status');
  const goBtn = document.getElementById('go-curs') as HTMLAnchorElement | null;

  async function checkUnlocked(): Promise<boolean> {
    if (!isAuthenticated()) return false;
    const lesson = await getLesson('02-micro-taskuri');
    return Boolean(lesson?.is_unlocked);
  }

  (async () => {
    for (let i = 0; i < 10; i++) {
      if (await checkUnlocked()) {
        if (statusEl) statusEl.textContent = 'Acces activat. Poți începe imediat!';
        if (goBtn) {
          goBtn.setAttribute('aria-disabled', 'false');
          goBtn.classList.remove('disabled:opacity-50');
        }
        return;
      }
      await new Promise((r) => setTimeout(r, 2000));
    }
    if (statusEl) statusEl.textContent = 'Accesul se activează. Dacă durează prea mult, încearcă din nou în câteva minute.';
    if (goBtn) {
      goBtn.setAttribute('aria-disabled', 'false');
      goBtn.classList.remove('disabled:opacity-50');
    }
  })();
</script>
