---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resetează parola — BaniOnline" description="Trimite un link pentru resetarea parolei.">
  <section class="mx-auto w-full max-w-md px-5 py-20 sm:px-8">
    <div class="mb-8 text-center">
      <h1 class="font-sans text-3xl font-extrabold tracking-tight text-ink">Resetează parola</h1>
      <p class="mt-2 text-sm text-slate-600">Îți trimitem pe email un link de resetare.</p>
    </div>

    <form id="reset-form" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-8 shadow-soft">
      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-slate-700">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm text-ink outline-none transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
          placeholder="tu@email.com"
        />
      </div>

      <p id="form-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></p>
      <p id="form-success" class="hidden rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"></p>

      <button
        type="submit"
        class="w-full rounded-lg bg-brand-600 px-6 py-3 text-base font-semibold text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-700"
      >
        Trimite link-ul
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-600">
      Ți-ai amintit parola?
      <a href="/login" class="font-semibold text-brand-600 hover:text-brand-700">Intră în cont</a>
    </p>
  </section>
</Layout>

<script>
  import { requestPasswordReset } from '../lib/api';

  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('form-error') as HTMLParagraphElement | null;
  const successEl = document.getElementById('form-success') as HTMLParagraphElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    if (errorEl) errorEl.classList.add('hidden');
    if (successEl) successEl.classList.add('hidden');
    try {
      await requestPasswordReset(email);
      if (successEl) {
        successEl.textContent = 'Dacă există un cont cu acest email, am trimis un link de resetare.';
        successEl.classList.remove('hidden');
      }
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : 'Nu am putut trimite link-ul de resetare.';
        errorEl.classList.remove('hidden');
      }
    }
  });
</script>
