---
import Badge from './ui/Badge.astro';

interface Props {
  modules: Array<{
    id: string;
    data: {
      title?: string;
      order?: number;
      est_time?: string;
      free?: boolean;
      description?: string;
    };
  }>;
}

const { modules } = Astro.props;

const sorted = [...modules].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    sorted.map((m) => (
      <a
        href={`/curs/${m.id}`}
        class="group flex min-w-0 flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-soft transition-all hover:-translate-y-1 hover:border-brand-200 hover:shadow-lift"
      >
        <div class="mb-4 flex items-center justify-between">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-sm font-bold text-brand-700 transition-colors group-hover:bg-brand-600 group-hover:text-white">
            {(m.data.order ?? 0) + 1}
          </span>
          {m.data.free ? (
            <Badge tone="green">Gratuit</Badge>
          ) : (
            <Badge tone="slate">{m.data.est_time ?? ''}</Badge>
          )}
        </div>
        <h3 class="font-sans text-base font-semibold leading-snug text-ink">{m.data.title}</h3>
        {m.data.description && <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{m.data.description}</p>}
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-colors group-hover:text-brand-700">
          {m.data.free ? 'Începe gratuit' : 'Parte din curs'}
          <span class="transition-transform group-hover:translate-x-0.5">→</span>
        </span>
      </a>
    ))
  }
</div>
