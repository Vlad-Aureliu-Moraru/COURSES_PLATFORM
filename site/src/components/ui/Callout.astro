---
interface Props {
  tone?: 'info' | 'warning' | 'danger' | 'success';
  title?: string;
  class?: string;
}

const { tone = 'info', title, class: className = '' } = Astro.props;

const tones = {
  info: 'border-brand-200 bg-brand-50',
  warning: 'border-amber-200 bg-amber-50',
  danger: 'border-red-200 bg-red-50',
  success: 'border-emerald-200 bg-emerald-50',
};

const iconColor = {
  info: 'text-brand-600',
  warning: 'text-amber-600',
  danger: 'text-red-600',
  success: 'text-emerald-600',
};
---

<aside
  class:list={[
    'my-6 rounded-xl border p-5',
    tones[tone],
    className,
  ]}
>
  <div class="flex gap-3">
    <span class:list={['mt-0.5 shrink-0 text-lg leading-none', iconColor[tone]]} aria-hidden="true">◆</span>
    <div>
      {title && <p class="mb-1 font-semibold text-ink">{title}</p>}
      <div class="text-sm leading-relaxed text-slate-700"><slot /></div>
    </div>
  </div>
</aside>
