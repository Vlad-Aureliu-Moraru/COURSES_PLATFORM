---
interface Props {
  tone?: 'brand' | 'slate' | 'green' | 'amber';
  class?: string;
}

const { tone = 'brand', class: className = '' } = Astro.props;

const tones = {
  brand: 'bg-brand-50 text-brand-700 ring-brand-600/20',
  slate: 'bg-slate-100 text-slate-700 ring-slate-500/20',
  green: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
  amber: 'bg-amber-50 text-amber-800 ring-amber-600/20',
};
---

<span
  class:list={['inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset', tones[tone], className]}
>
  <slot />
</span>
