# ===== Development (local) =====
# Django
DJANGO_SECRET_KEY=django-insecure-dev-only-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS / CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8000
SITE_URL=http://localhost:4321

# Database
USE_SQLITE=True
POSTGRES_DB=banionline
POSTGRES_USER=banionline
POSTGRES_PASSWORD=banionline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Stripe
# NOTE: automatic_tax is enabled in create_checkout_session. Stripe Tax must be
# enabled in the Stripe dashboard (Settings → Tax → Get started) for checkout to work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (dev: console; prod: Resend SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ===== Production (docker-compose on VPS) =====
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.banionline.ro
# CSRF_TRUSTED_ORIGINS=https://banionline.ro
# CORS_ALLOWED_ORIGINS=https://banionline.ro
# SITE_URL=https://banionline.ro
#
# # DB: compose `db` service (or any external Postgres DSN)
# DATABASE_URL=postgresql://banionline:PASSWORD@localhost:5432/banionline
# USE_SQLITE=False
#
# # Resend SMTP (free tier: 3,000 emails/mo)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_XXXXXXXXXXXXXXXX
# EMAIL_USE_TLS=True
